{
  "id": "https://iris.shreyaskamat.in/genui/library/v1",
  "version": "0.1.0",
  "root": "Stack",
  "schema": {
    "properties": {
      "Stack": {
        "$ref": "#/$defs/Stack"
      },
      "Card": {
        "$ref": "#/$defs/Card"
      },
      "Section": {
        "$ref": "#/$defs/Section"
      },
      "Divider": {
        "$ref": "#/$defs/Divider"
      },
      "Tabs": {
        "$ref": "#/$defs/Tabs"
      },
      "Tab": {
        "$ref": "#/$defs/Tab"
      },
      "Expander": {
        "$ref": "#/$defs/Expander"
      },
      "Text": {
        "$ref": "#/$defs/Text"
      },
      "Markdown": {
        "$ref": "#/$defs/Markdown"
      },
      "KeyValue": {
        "$ref": "#/$defs/KeyValue"
      },
      "Stat": {
        "$ref": "#/$defs/Stat"
      },
      "StatRow": {
        "$ref": "#/$defs/StatRow"
      },
      "StatusPill": {
        "$ref": "#/$defs/StatusPill"
      },
      "Table": {
        "$ref": "#/$defs/Table"
      },
      "ListRow": {
        "$ref": "#/$defs/ListRow"
      },
      "Timeline": {
        "$ref": "#/$defs/Timeline"
      },
      "TimelineItem": {
        "$ref": "#/$defs/TimelineItem"
      },
      "Checklist": {
        "$ref": "#/$defs/Checklist"
      },
      "ChecklistItem": {
        "$ref": "#/$defs/ChecklistItem"
      },
      "Progress": {
        "$ref": "#/$defs/Progress"
      },
      "CodeBlock": {
        "$ref": "#/$defs/CodeBlock"
      },
      "Diff": {
        "$ref": "#/$defs/Diff"
      },
      "Image": {
        "$ref": "#/$defs/Image"
      },
      "Link": {
        "$ref": "#/$defs/Link"
      },
      "Sparkline": {
        "$ref": "#/$defs/Sparkline"
      },
      "Series": {
        "$ref": "#/$defs/Series"
      },
      "LineChart": {
        "$ref": "#/$defs/LineChart"
      },
      "BarChart": {
        "$ref": "#/$defs/BarChart"
      },
      "Donut": {
        "$ref": "#/$defs/Donut"
      },
      "Slice": {
        "$ref": "#/$defs/Slice"
      },
      "ChoiceChips": {
        "$ref": "#/$defs/ChoiceChips"
      },
      "Input": {
        "$ref": "#/$defs/Input"
      },
      "Slider": {
        "$ref": "#/$defs/Slider"
      },
      "Toggle": {
        "$ref": "#/$defs/Toggle"
      },
      "DatePicker": {
        "$ref": "#/$defs/DatePicker"
      },
      "Stepper": {
        "$ref": "#/$defs/Stepper"
      },
      "ApproveReject": {
        "$ref": "#/$defs/ApproveReject"
      },
      "Submit": {
        "$ref": "#/$defs/Submit"
      },
      "Button": {
        "$ref": "#/$defs/Button"
      }
    },
    "$defs": {
      "Stack": {
        "type": "object",
        "description": "Lays out children in a column (default) or a row. Use it as the root of almost every display",
        "properties": {
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Component"
            }
          },
          "direction": {
            "type": "string",
            "enum": [
              "column",
              "row"
            ]
          },
          "gap": {
            "type": "string",
            "enum": [
              "s",
              "m",
              "l"
            ]
          }
        },
        "required": [
          "children"
        ]
      },
      "Card": {
        "type": "object",
        "description": "A bordered container with an optional title. One card per idea; do not nest cards",
        "properties": {
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Component"
            }
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "children"
        ]
      },
      "Section": {
        "type": "object",
        "description": "A heading followed by content, for grouping without a border",
        "properties": {
          "title": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Component"
            }
          }
        },
        "required": [
          "title",
          "children"
        ]
      },
      "Divider": {
        "type": "object",
        "description": "A thin line between groups. Prefer Section to a bare divider",
        "properties": {}
      },
      "Tabs": {
        "type": "object",
        "description": "Switches between Tab children, one visible at a time. Keep to 2 to 5 tabs",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Tab"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "Tab": {
        "type": "object",
        "description": "One page of a Tabs; the label is the tab title and should be a word or two",
        "properties": {
          "label": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Component"
            }
          }
        },
        "required": [
          "label",
          "children"
        ]
      },
      "Expander": {
        "type": "object",
        "description": "A title that opens to reveal children; use for detail most people will not need",
        "properties": {
          "title": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Component"
            }
          },
          "open": {
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "children"
        ]
      },
      "Text": {
        "type": "object",
        "description": "A run of text; title is a heading, caption is small and muted, mono is for ids and paths",
        "properties": {
          "value": {
            "type": "string"
          },
          "variant": {
            "type": "string",
            "enum": [
              "body",
              "title",
              "caption",
              "mono"
            ]
          }
        },
        "required": [
          "value"
        ]
      },
      "Markdown": {
        "type": "object",
        "description": "Formatted text (bold, lists, links, code); use when the content is already Markdown",
        "properties": {
          "value": {
            "type": "string"
          }
        },
        "required": [
          "value"
        ]
      },
      "KeyValue": {
        "type": "object",
        "description": "A label with its value on one line, for facts such as \"Region: eu-west\"",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "value"
        ]
      },
      "Stat": {
        "type": "object",
        "description": "One big number with a label and an optional change; keep value short, such as \"12\" or \"98%\"",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "delta": {
            "type": "string"
          },
          "trend": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "flat"
            ]
          }
        },
        "required": [
          "label",
          "value"
        ]
      },
      "StatRow": {
        "type": "object",
        "description": "A row of 2 to 4 Stat components that share the width",
        "properties": {
          "stats": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Stat"
            }
          }
        },
        "required": [
          "stats"
        ]
      },
      "StatusPill": {
        "type": "object",
        "description": "A small coloured status label; tone says how it feels, so pick it for meaning, not looks",
        "properties": {
          "label": {
            "type": "string"
          },
          "tone": {
            "type": "string",
            "enum": [
              "neutral",
              "good",
              "warn",
              "bad"
            ]
          }
        },
        "required": [
          "label"
        ]
      },
      "Table": {
        "type": "object",
        "description": "A grid of text. columns are the headings; each row has one cell per column. Up to about 6 columns",
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {}
            }
          }
        },
        "required": [
          "columns",
          "rows"
        ]
      },
      "ListRow": {
        "type": "object",
        "description": "A row with a title, an optional second line and trailing text, for lists of things",
        "properties": {
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "trailing": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      },
      "Timeline": {
        "type": "object",
        "description": "Events in time order, oldest first, joined by a line",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/TimelineItem"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "TimelineItem": {
        "type": "object",
        "description": "One event on a Timeline; time is shown as given, so write it the way a person would say it",
        "properties": {
          "title": {
            "type": "string"
          },
          "time": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      },
      "Checklist": {
        "type": "object",
        "description": "A read-only list of items that are done or not yet done",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ChecklistItem"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "ChecklistItem": {
        "type": "object",
        "description": "One line of a Checklist; done defaults to false",
        "properties": {
          "label": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        },
        "required": [
          "label"
        ]
      },
      "Progress": {
        "type": "object",
        "description": "A bar (or ring) showing a value from 0 to 100, not a fraction",
        "properties": {
          "value": {
            "type": "number"
          },
          "label": {
            "type": "string"
          },
          "style": {
            "type": "string",
            "enum": [
              "bar",
              "ring"
            ]
          }
        },
        "required": [
          "value"
        ]
      },
      "CodeBlock": {
        "type": "object",
        "description": "Monospaced code with copy; language is a short name such as \"dart\" or \"bash\"",
        "properties": {
          "code": {
            "type": "string"
          },
          "language": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "Diff": {
        "type": "object",
        "description": "Two versions of some text, with the changed lines marked. Use for edits, not for general comparison",
        "properties": {
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          }
        },
        "required": [
          "before",
          "after"
        ]
      },
      "Image": {
        "type": "object",
        "description": "A picture from an allowed image host. alt is required and should describe it for a screen reader",
        "properties": {
          "url": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "alt"
        ]
      },
      "Link": {
        "type": "object",
        "description": "Text that opens a web address after the person confirms. Use for sources, not for actions",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "url"
        ]
      },
      "Sparkline": {
        "type": "object",
        "description": "A small trend line with no axes, for a quick sense of direction. Use LineChart when the person needs to read values",
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "values"
        ]
      },
      "Series": {
        "type": "object",
        "description": "One named run of numbers in a LineChart or BarChart; keep the name short, it labels the legend",
        "properties": {
          "name": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "name",
          "values"
        ]
      },
      "LineChart": {
        "type": "object",
        "description": "One to four Series as lines over shared labels, such as days. Every Series needs the same number of values as labels",
        "properties": {
          "series": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Series"
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "series"
        ]
      },
      "BarChart": {
        "type": "object",
        "description": "One to four Series as grouped bars over shared labels. The baseline is zero, so use it to compare amounts, not to show a trend",
        "properties": {
          "series": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Series"
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "series"
        ]
      },
      "Donut": {
        "type": "object",
        "description": "Shares of a whole, up to 12 Slice values, shown as a ring with a legend. Use for parts of a total, not for trends",
        "properties": {
          "slices": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Slice"
            }
          }
        },
        "required": [
          "slices"
        ]
      },
      "Slice": {
        "type": "object",
        "description": "One share of a Donut; value is any positive amount and the percentage is worked out for you",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        },
        "required": [
          "label",
          "value"
        ]
      },
      "ChoiceChips": {
        "type": "object",
        "description": "A row of options to pick from. value is the chosen option, or with multi the list of chosen options. Use for a few short choices",
        "properties": {
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "value": {},
          "multi": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "options"
        ]
      },
      "Input": {
        "type": "object",
        "description": "A text field. kind \"number\" stores a number, \"multiline\" gives room for a paragraph",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "placeholder": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "number",
              "multiline"
            ]
          }
        },
        "required": [
          "label"
        ]
      },
      "Slider": {
        "type": "object",
        "description": "Pick a number between min and max by dragging. step makes it move in whole steps. Use when the exact value matters less than the rough amount",
        "properties": {
          "label": {
            "type": "string"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "value": {
            "type": "number"
          },
          "step": {
            "type": "number"
          }
        },
        "required": [
          "label",
          "min",
          "max"
        ]
      },
      "Toggle": {
        "type": "object",
        "description": "An on/off switch with a label. value is true or false",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "boolean"
          }
        },
        "required": [
          "label"
        ]
      },
      "DatePicker": {
        "type": "object",
        "description": "Pick a calendar date. value is written as text like \"2026-11-07\"",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "label"
        ]
      },
      "Stepper": {
        "type": "object",
        "description": "A number with minus and plus buttons, for small counts such as guests or retries",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number"
          }
        },
        "required": [
          "label"
        ]
      },
      "ApproveReject": {
        "type": "object",
        "description": "Two buttons for a yes-or-no decision, plus an optional third for asking first. Each sends its own label as the reply, so write each label as a sentence the person would say",
        "properties": {
          "approveLabel": {
            "type": "string"
          },
          "rejectLabel": {
            "type": "string"
          },
          "askLabel": {
            "type": "string"
          }
        },
        "required": [
          "approveLabel",
          "rejectLabel"
        ]
      },
      "Submit": {
        "type": "object",
        "description": "The primary button that ends a form. Its action runs with the values the person has entered, e.g. @Ask(\"Here is my answer\", {choice: $choice})",
        "properties": {
          "label": {
            "type": "string"
          },
          "action": {
            "$ref": "#/$defs/ActionExpression"
          }
        },
        "required": [
          "label",
          "action"
        ]
      },
      "Button": {
        "type": "object",
        "description": "A button. Without an action it sends its label to the assistant as the person's next message",
        "properties": {
          "label": {
            "type": "string"
          },
          "action": {
            "$ref": "#/$defs/ActionExpression"
          },
          "variant": {
            "type": "string",
            "enum": [
              "primary",
              "secondary"
            ]
          }
        },
        "required": [
          "label"
        ]
      },
      "Component": {
        "anyOf": [
          {
            "$ref": "#/$defs/Stack"
          },
          {
            "$ref": "#/$defs/Card"
          },
          {
            "$ref": "#/$defs/Section"
          },
          {
            "$ref": "#/$defs/Divider"
          },
          {
            "$ref": "#/$defs/Tabs"
          },
          {
            "$ref": "#/$defs/Tab"
          },
          {
            "$ref": "#/$defs/Expander"
          },
          {
            "$ref": "#/$defs/Text"
          },
          {
            "$ref": "#/$defs/Markdown"
          },
          {
            "$ref": "#/$defs/KeyValue"
          },
          {
            "$ref": "#/$defs/Stat"
          },
          {
            "$ref": "#/$defs/StatRow"
          },
          {
            "$ref": "#/$defs/StatusPill"
          },
          {
            "$ref": "#/$defs/Table"
          },
          {
            "$ref": "#/$defs/ListRow"
          },
          {
            "$ref": "#/$defs/Timeline"
          },
          {
            "$ref": "#/$defs/TimelineItem"
          },
          {
            "$ref": "#/$defs/Checklist"
          },
          {
            "$ref": "#/$defs/ChecklistItem"
          },
          {
            "$ref": "#/$defs/Progress"
          },
          {
            "$ref": "#/$defs/CodeBlock"
          },
          {
            "$ref": "#/$defs/Diff"
          },
          {
            "$ref": "#/$defs/Image"
          },
          {
            "$ref": "#/$defs/Link"
          },
          {
            "$ref": "#/$defs/Sparkline"
          },
          {
            "$ref": "#/$defs/Series"
          },
          {
            "$ref": "#/$defs/LineChart"
          },
          {
            "$ref": "#/$defs/BarChart"
          },
          {
            "$ref": "#/$defs/Donut"
          },
          {
            "$ref": "#/$defs/Slice"
          },
          {
            "$ref": "#/$defs/ChoiceChips"
          },
          {
            "$ref": "#/$defs/Input"
          },
          {
            "$ref": "#/$defs/Slider"
          },
          {
            "$ref": "#/$defs/Toggle"
          },
          {
            "$ref": "#/$defs/DatePicker"
          },
          {
            "$ref": "#/$defs/Stepper"
          },
          {
            "$ref": "#/$defs/ApproveReject"
          },
          {
            "$ref": "#/$defs/Submit"
          },
          {
            "$ref": "#/$defs/Button"
          }
        ]
      },
      "ActionExpression": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "open_url"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "url"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "continue_conversation"
              },
              "context": {
                "type": "string"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "params": {
                "type": "object"
              }
            },
            "required": [
              "type"
            ]
          }
        ]
      }
    },
    "functions": {
      "Percent": {
        "description": "done as a percentage of total, rounded to a whole number",
        "params": {
          "type": "object",
          "properties": {
            "done": {
              "type": "number"
            },
            "total": {
              "type": "number"
            }
          },
          "required": [
            "done",
            "total"
          ]
        },
        "returns": {
          "type": "number"
        }
      },
      "Money": {
        "description": "value formatted as money in the given ISO currency code, such as \"GBP\"",
        "params": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "currency": {
              "type": "string"
            }
          },
          "required": [
            "value",
            "currency"
          ]
        },
        "returns": {
          "type": "string"
        }
      },

  "components": {
    "Stack": {
      "signature": "Stack(children: any[], direction?: \"column\" | \"row\", gap?: \"s\" | \"m\" | \"l\")",
      "description": "Lays out children in a column (default) or a row. Use it as the root of almost every display"
    },
    "Card": {
      "signature": "Card(children: any[], title?: string)",
      "description": "A bordered container with an optional title. One card per idea; do not nest cards"
    },
    "Section": {
      "signature": "Section(title: string, children: any[])",
      "description": "A heading followed by content, for grouping without a border"
    },
    "Divider": {
      "signature": "Divider()",
      "description": "A thin line between groups. Prefer Section to a bare divider"
    },
    "Tabs": {
      "signature": "Tabs(items: Tab[])",
      "description": "Switches between Tab children, one visible at a time. Keep to 2 to 5 tabs"
    },
    "Tab": {
      "signature": "Tab(label: string, children: any[])",
      "description": "One page of a Tabs; the label is the tab title and should be a word or two"
    },
    "Expander": {
      "signature": "Expander(title: string, children: any[], open?: boolean)",
      "description": "A title that opens to reveal children; use for detail most people will not need"
    },
    "Text": {
      "signature": "Text(value: string, variant?: \"body\" | \"title\" | \"caption\" | \"mono\")",
      "description": "A run of text; title is a heading, caption is small and muted, mono is for ids and paths"
    },
    "Markdown": {
      "signature": "Markdown(value: string)",
      "description": "Formatted text (bold, lists, links, code); use when the content is already Markdown"
    },
    "KeyValue": {
      "signature": "KeyValue(key: string, value: string)",
      "description": "A label with its value on one line, for facts such as \"Region: eu-west\""
    },
    "Stat": {
      "signature": "Stat(label: string, value: string, delta?: string, trend?: \"up\" | \"down\" | \"flat\")",
      "description": "One big number with a label and an optional change; keep value short, such as \"12\" or \"98%\""
    },
    "StatRow": {
      "signature": "StatRow(stats: Stat[])",
      "description": "A row of 2 to 4 Stat components that share the width"
    },
    "StatusPill": {
      "signature": "StatusPill(label: string, tone?: \"neutral\" | \"good\" | \"warn\" | \"bad\")",
      "description": "A small coloured status label; tone says how it feels, so pick it for meaning, not looks"
    },
    "Table": {
      "signature": "Table(columns: string[], rows: any[][])",
      "description": "A grid of text. columns are the headings; each row has one cell per column. Up to about 6 columns"
    },
    "ListRow": {
      "signature": "ListRow(title: string, subtitle?: string, trailing?: string)",
      "description": "A row with a title, an optional second line and trailing text, for lists of things"
    },
    "Timeline": {
      "signature": "Timeline(items: TimelineItem[])",
      "description": "Events in time order, oldest first, joined by a line"
    },
    "TimelineItem": {
      "signature": "TimelineItem(title: string, time?: string, detail?: string)",
      "description": "One event on a Timeline; time is shown as given, so write it the way a person would say it"
    },
    "Checklist": {
      "signature": "Checklist(items: ChecklistItem[])",
      "description": "A read-only list of items that are done or not yet done"
    },
    "ChecklistItem": {
      "signature": "ChecklistItem(label: string, done?: boolean)",
      "description": "One line of a Checklist; done defaults to false"
    },
    "Progress": {
      "signature": "Progress(value: number, label?: string, style?: \"bar\" | \"ring\")",
      "description": "A bar (or ring) showing a value from 0 to 100, not a fraction"
    },
    "CodeBlock": {
      "signature": "CodeBlock(code: string, language?: string)",
      "description": "Monospaced code with copy; language is a short name such as \"dart\" or \"bash\""
    },
    "Diff": {
      "signature": "Diff(before: string, after: string)",
      "description": "Two versions of some text, with the changed lines marked. Use for edits, not for general comparison"
    },
    "Image": {
      "signature": "Image(url: string, alt: string)",
      "description": "A picture from an allowed image host. alt is required and should describe it for a screen reader"
    },
    "Link": {
      "signature": "Link(label: string, url: string)",
      "description": "Text that opens a web address after the person confirms. Use for sources, not for actions"
    },
    "Sparkline": {
      "signature": "Sparkline(values: number[])",
      "description": "A small trend line with no axes, for a quick sense of direction. Use LineChart when the person needs to read values"
    },
    "Series": {
      "signature": "Series(name: string, values: number[])",
      "description": "One named run of numbers in a LineChart or BarChart; keep the name short, it labels the legend"
    },
    "LineChart": {
      "signature": "LineChart(series: Series[], labels?: string[])",
      "description": "One to four Series as lines over shared labels, such as days. Every Series needs the same number of values as labels"
    },
    "BarChart": {
      "signature": "BarChart(series: Series[], labels?: string[])",
      "description": "One to four Series as grouped bars over shared labels. The baseline is zero, so use it to compare amounts, not to show a trend"
    },
    "Donut": {
      "signature": "Donut(slices: Slice[])",
      "description": "Shares of a whole, up to 12 Slice values, shown as a ring with a legend. Use for parts of a total, not for trends"
    },
    "Slice": {
      "signature": "Slice(label: string, value: number)",
      "description": "One share of a Donut; value is any positive amount and the percentage is worked out for you"
    },
    "ChoiceChips": {
      "signature": "ChoiceChips(options: string[], value?: $binding<any>, multi?: boolean, label?: string)",
      "description": "A row of options to pick from. value is the chosen option, or with multi the list of chosen options. Use for a few short choices"
    },
    "Input": {
      "signature": "Input(label: string, value?: $binding<string>, placeholder?: string, kind?: \"text\" | \"number\" | \"multiline\")",
      "description": "A text field. kind \"number\" stores a number, \"multiline\" gives room for a paragraph"
    },
    "Slider": {
      "signature": "Slider(label: string, min: number, max: number, value?: $binding<number>, step?: number)",
      "description": "Pick a number between min and max by dragging. step makes it move in whole steps. Use when the exact value matters less than the rough amount"
    },
    "Toggle": {
      "signature": "Toggle(label: string, value?: $binding<boolean>)",
      "description": "An on/off switch with a label. value is true or false"
    },
    "DatePicker": {
      "signature": "DatePicker(label: string, value?: $binding<string>)",
      "description": "Pick a calendar date. value is written as text like \"2026-11-07\""
    },
    "Stepper": {
      "signature": "Stepper(label: string, value?: $binding<number>, min?: number, max?: number, step?: number)",
      "description": "A number with minus and plus buttons, for small counts such as guests or retries"
    },
    "ApproveReject": {
      "signature": "ApproveReject(approveLabel: string, rejectLabel: string, askLabel?: string)",
      "description": "Two buttons for a yes-or-no decision, plus an optional third for asking first. Each sends its own label as the reply, so write each label as a sentence the person would say"
    },
    "Submit": {
      "signature": "Submit(label: string, action: ActionExpression)",
      "description": "The primary button that ends a form. Its action runs with the values the person has entered, e.g. @Ask(\"Here is my answer\", {choice: $choice})"
    },
    "Button": {
      "signature": "Button(label: string, action?: ActionExpression, variant?: \"primary\" | \"secondary\")",
      "description": "A button. Without an action it sends its label to the assistant as the person's next message"
    }
  },

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Nested Gradle/Xcode build output (the root-anchored /build/ misses android/build)
**/build/

# Secrets and signing material. None of these may ever be committed.
*.jks
*.keystore
*.p12
*.pem
*.mobileprovision
key.properties
.env
.env.*
.iris-live.json
google-services.json
GoogleService-Info.plist

# Golden test failure output (diffs, master and test images). Local only.
test/**/failures/

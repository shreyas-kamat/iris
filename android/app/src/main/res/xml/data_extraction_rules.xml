<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing Iris stores is copied off the phone: not to cloud backup, and not
  when the user moves to a new device. That includes the saved server
  addresses and settings. Secrets live in the Android Keystore and could not
  be restored elsewhere anyway, so a restored copy would be half a setup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
